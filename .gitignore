# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Raw dataset dumps only — regeneratable via ingestion scripts, not versioned
backend/knowledge_base/raw_data/**/raw_dump.jsonl

# Keep provenance, filter reports, and small curated outputs — these ARE versioned
!backend/knowledge_base/raw_data/**/provenance.json
!backend/knowledge_base/raw_data/**/filter_report.json
!backend/knowledge_base/raw_data/**/filtered_candidates.jsonl